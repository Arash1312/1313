## `src/core/logger.py`

```python
import logging
from .config import settings


def setup_logger() -> logging.Logger:
    logger = logging.getLogger(settings.app_name)

    if logger.handlers:
        return logger

    logger.setLevel(settings.log_level)

    handler = logging.StreamHandler()
    formatter = logging.Formatter(
        "%(asctime)s | %(levelname)s | %(name)s | %(message)s"
    )

    handler.setFormatter(formatter)
    logger.addHandler(handler)

    return logger


logger = setup_logger()
```

## `src/services/processor.py`

```python
from dataclasses import dataclass
from typing import Any

from src.core.logger import logger


@dataclass
class ProcessingResult:
    success: bool
    data: Any = None
    error: str | None = None


class Processor:
    """
    Core processing layer for NexusFlow.

    The processor is intentionally independent from external
    services so that additional integrations can be added
    without changing the core architecture.
    """

    def process(self, payload: dict) -> ProcessingResult:
        try:
            if not isinstance(payload, dict):
                raise TypeError("Payload must be a dictionary.")

            if not payload:
                raise ValueError("Payload cannot be empty.")

            logger.info("Processing request")

            result = {
                "status": "processed",
                "payload": payload,
            }

            logger.info("Request processed successfully")

            return ProcessingResult(
                success=True,
                data=result,
            )

        except Exception as exc:
            logger.exception("Processing failed")

            return ProcessingResult(
                success=False,
                error=str(exc),
            )
```

## `src/main.py`

```python
from src.services.processor import Processor
from src.core.logger import logger


def main() -> None:
    processor = Processor()

    payload = {
        "action": "execute",
        "source": "NexusFlow",
    }

    result = processor.process(payload)

    if result.success:
        logger.info("Result: %s", result.data)
    else:
        logger.error("Error: %s", result.error)


if __name__ == "__main__":
    main()
```

## `tests/test_processor.py`

```python
from src.services.processor import Processor


def test_processor_success():
    processor = Processor()

    result = processor.process(
        {
            "action": "test",
            "value": 1,
        }
    )

    assert result.success is True
    assert result.data["status"] == "processed"


def test_processor_rejects_empty_payload():
    processor = Processor()

    result = processor.process({})

    assert result.success is False
    assert result.error is not None
